{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcritic.local/schemas/public-building-case.schema.json",
  "title": "ArchCritic 公共建筑案例",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "title", "architect", "location", "year", "scale", "building_type", "reliable_source_record_ids", "media_record_ids", "site_strategy", "functional_organization", "circulation", "spatial_sequence", "form_strategy", "structure_strategy", "environmental_response", "key_drawings", "transferable_lessons", "application_limits", "related_knowledge_cards", "similar_cases", "depth_evidence_categories", "evidence_register", "media_permission_status", "draft_scope", "review_status", "reviewer", "version"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^PBC-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "architect": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "year": {"type": ["integer", "string"]},
    "scale": {"type": "string", "minLength": 1},
    "building_type": {"type": "string", "minLength": 1},
    "reliable_source_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "media_record_ids": {"type": "array", "items": {"type": "string"}},
    "site_strategy": {"type": "string", "minLength": 1},
    "functional_organization": {"type": "string", "minLength": 1},
    "circulation": {"type": "string", "minLength": 1},
    "spatial_sequence": {"type": "string", "minLength": 1},
    "form_strategy": {"type": "string", "minLength": 1},
    "structure_strategy": {"type": "string", "minLength": 1},
    "environmental_response": {"type": "string", "minLength": 1},
    "key_drawings": {"type": "array", "items": {"type": "string"}},
    "transferable_lessons": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string"}},
    "application_limits": {"type": "string", "minLength": 1},
    "related_knowledge_cards": {"type": "array", "items": {"type": "string"}},
    "similar_cases": {"type": "array", "items": {"type": "string"}},
    "depth_evidence_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["site", "function_and_circulation", "space_and_form", "section_or_structure"]}},
    "evidence_register": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "source_id", "locator", "supports", "evidence_type"],
        "properties": {
          "category": {"enum": ["site", "function_and_circulation", "space_and_form", "section_or_structure", "basic_fact"]},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "supports": {"type": "string", "minLength": 1},
          "evidence_type": {"enum": ["official_fact", "disciplinary_inference"]}
        }
      }
    },
    "media_permission_status": {"enum": ["not_cleared", "partially_cleared", "cleared"]},
    "draft_scope": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["draft", "pending", "approved", "rejected"]},
    "reviewer": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1}
  }
}
