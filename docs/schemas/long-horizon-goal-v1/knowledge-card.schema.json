{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcritic.local/schemas/knowledge-card.schema.json",
  "title": "ArchCritic 教学知识卡",
  "type": "object",
  "additionalProperties": false,
  "required": ["card_id", "title", "level", "learning_objective", "prerequisites", "building_types", "stages", "dimensions", "student_explanation", "key_terms", "related_cards", "related_cases", "self_test", "source_type", "source_record_ids", "source_locators", "copyright_status", "allowed_use", "organizer", "review_status", "reviewer", "version"],
  "properties": {
    "card_id": {"type": "string", "pattern": "^KC-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "level": {"enum": ["beginner", "advanced", "master"]},
    "learning_objective": {"type": "string", "minLength": 1},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "building_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stages": {"type": "array", "minItems": 1, "items": {"enum": ["concept", "scheme", "drawing"]}},
    "dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "student_explanation": {"type": "string", "minLength": 1},
    "key_terms": {"type": "array", "items": {"type": "string"}},
    "related_cards": {"type": "array", "items": {"type": "string"}},
    "related_cases": {"type": "array", "items": {"type": "string"}},
    "self_test": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["question", "expected_points"], "properties": {"question": {"type": "string", "minLength": 1}, "expected_points": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "source_type": {"enum": ["standard", "government_guidance", "textbook", "case", "teacher_experience", "ai_summary"]},
    "source_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_locators": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "locator"], "properties": {"source_id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "note": {"type": "string"}}}},
    "copyright_status": {"type": "string", "minLength": 1},
    "allowed_use": {"enum": ["internal_only", "demo_allowed", "public_allowed"]},
    "organizer": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["draft", "pending", "approved", "rejected"]},
    "reviewer": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1}
  }
}
