{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcritic.local/schemas/content-evaluation-task.schema.json",
  "title": "ArchCritic Content Evaluation Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_type",
    "query_or_problem",
    "design_stage",
    "building_type",
    "expected_knowledge_card_ids",
    "expected_case_ids",
    "acceptable_case_ids",
    "required_reason_points",
    "forbidden_behaviors",
    "review_status",
    "reviewer",
    "version"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^(CRT|PLT)-[0-9]{3}$"},
    "task_type": {"enum": ["case_retrieval", "problem_linkage"]},
    "query_or_problem": {"type": "string", "minLength": 8},
    "design_stage": {"enum": ["concept", "scheme", "drawing", "all"]},
    "building_type": {"type": "string", "minLength": 2},
    "problem_category": {
      "enum": ["case_lookup", "site", "function_and_circulation", "space_and_form", "structure_and_environment", "representation_and_evidence"]
    },
    "expected_knowledge_card_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^KC-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "expected_case_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^PBC-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "acceptable_case_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^PBC-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "required_reason_points": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 2}
    },
    "forbidden_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 2}
    },
    "review_status": {"enum": ["draft", "pending", "approved", "rejected"]},
    "reviewer": {"type": "string", "minLength": 2},
    "version": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
