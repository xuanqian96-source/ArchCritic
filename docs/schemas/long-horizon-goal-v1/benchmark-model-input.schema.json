{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcritic.local/schemas/benchmark-model-input.schema.json",
  "title": "ArchCritic 匿名模型输入",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "project_name", "building_type", "grade", "design_stage", "taskbook_version", "description", "drawings", "authorization_record_id", "anonymization_record_id", "input_version"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9-]+$"},
    "project_name": {"type": "string", "minLength": 1},
    "building_type": {"type": "string", "minLength": 1},
    "grade": {"type": "string", "minLength": 1},
    "design_stage": {"enum": ["concept", "scheme", "drawing"]},
    "taskbook_version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "authorization_record_id": {"type": "string", "minLength": 1},
    "anonymization_record_id": {"type": "string", "minLength": 1},
    "input_version": {"type": "string", "minLength": 1},
    "drawings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["drawing_id", "drawing_type", "relative_path", "mime_type", "sha256", "description"],
        "properties": {
          "drawing_id": {"type": "string", "minLength": 1},
          "drawing_type": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "mime_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "description": {"type": "string"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "low_resolution": {"type": "boolean"}
        }
      }
    }
  }
}
