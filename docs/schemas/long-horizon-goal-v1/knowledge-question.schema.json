{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcritic.local/schemas/knowledge-question.schema.json",
  "title": "ArchCritic 固定知识问答",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "level", "question_type", "question", "expected_answer_points", "expected_source_record_ids", "expected_source_locators", "forbidden_behaviors", "review_status", "reviewer", "version"],
  "properties": {
    "question_id": {"type": "string", "pattern": "^Q-[A-Z0-9-]+$"},
    "level": {"enum": ["beginner", "advanced", "master"]},
    "question_type": {"enum": ["evidence_based", "unanswerable", "adversarial"]},
    "question": {"type": "string", "minLength": 1},
    "expected_answer_points": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_source_record_ids": {"type": "array", "items": {"type": "string"}},
    "expected_source_locators": {"type": "array", "items": {"type": "string"}},
    "forbidden_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "review_status": {"enum": ["draft", "pending", "approved", "rejected"]},
    "reviewer": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1}
  }
}
