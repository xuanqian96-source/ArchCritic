# ArchCritic 生产后端环境变量模板；模型密钥由服务器管理员单独填写。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER=dashscope
LLM_MODEL=qwen3.8-max
LLM_ASSISTANT_MODEL=qwen3.7-plus
LLM_TIMEOUT_SECONDS=150
LLM_AGENT_TIMEOUT_SECONDS=50
LLM_REVIEW_TIMEOUT_SECONDS=285
KNOWLEDGE_ASSISTANT_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2200
LLM_IMAGE_DETAIL=high
LLM_TRUST_ENV=true
LLM_MAX_MODEL_IMAGE_BYTES=15728640
LLM_IMAGE_MAX_SIDE=2048
SCORING_ARCHITECTURE=legacy_v1

DATABASE_URL=sqlite:////var/lib/archcritic/archcritic.db
UPLOAD_DIR=/var/lib/archcritic/uploads
WIKI_DIR=/var/lib/archcritic/wiki

CORS_ORIGINS=https://archcritic.cn,https://www.archcritic.cn,https://archcritic-dpcyvy0jmhdf.edgeone.cool,https://app.archcritic.cn
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
